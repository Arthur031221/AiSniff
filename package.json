{
  "name": "aisniff-cli",
  "version": "0.1.0",
  "description": "Paste Traditional Chinese or English text and see which phrases read like AI wrote them, each with the rule, the source and a rewrite hint",
  "type": "module",
  "license": "MIT",
  "author": "Arthur031221",
  "bin": {
    "aisniff": "dist/cli/aisniff.mjs"
  },
  "files": [
    "dist/cli",
    "rules",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.cli.config.ts",
    "build:web": "vite build",
    "build:cli": "vite build -c vite.cli.config.ts",
    "prepare": "node scripts/prepare.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --noEmit && prettier --check .",
    "eval": "tsx scripts/eval-hc3.ts",
    "check:sources": "tsx scripts/check-sources.ts",
    "media": "tsx scripts/make-media.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arthur031221/AiSniff.git"
  },
  "homepage": "https://arthur031221.github.io/AiSniff/",
  "bugs": {
    "url": "https://github.com/Arthur031221/AiSniff/issues"
  },
  "keywords": [
    "ai-writing",
    "humanizer",
    "linter",
    "traditional-chinese",
    "zh-tw",
    "text-analysis",
    "editor",
    "highlight",
    "claude-skill"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^26.6.5",
    "opencc-js": "^1.4.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
